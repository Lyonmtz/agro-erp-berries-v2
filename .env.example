# ============================================================================
# AGRO-ERP Berries v2 - Variables de entorno ejemplo (.env.example)
# Copiar a .env para ejecucion local (nunca versionar .env con secretos reales)
# ============================================================================

APP_NAME=AGRO-ERP Berries
APP_VERSION=2.0.0
ENVIRONMENT=DEVELOPMENT
TZ=America/Mexico_City

# Base de datos principal (PostgreSQL 16 - agro_berries_erp)
POSTGRES_USER=agro_admin
POSTGRES_PASSWORD=DevPassword2026!
POSTGRES_DB=agro_berries_erp
POSTGRES_HOST_PORT=5435
DATABASE_URL=postgresql+asyncpg://agro_admin:DevPassword2026!@db:5432/agro_berries_erp

# Base de pruebas desechable verificada (PostgreSQL 16 efimero - db_test)
# Regla estricta: pytest solo ejecutara operaciones destructivas si AMBAS
# condiciones se cumplen:
#   1) ALLOW_DESTRUCTIVE_TEST_DB=true
#   2) SELECT db_environment FROM app_db_metadata WHERE id = 1 == 'DISPOSABLE_TEST'
TEST_POSTGRES_HOST_PORT=5436
TEST_DATABASE_URL=postgresql+asyncpg://agro_admin:DevPassword2026!@db_test:5432/agro_berries_erp_test
ALLOW_DESTRUCTIVE_TEST_DB=false

# Backend FastAPI
BACKEND_HOST_PORT=8001

# Seguridad
SECRET_KEY=DevSecretKey_Berries_2026
CORS_ORIGINS=*

# Integracion ERP central Merqry (ESTRICTAMENTE SOLO LECTURA)
# Separacion obligatoria de circuitos: IMSS -> Merqry | Especial -> Contabilidad
MERQRY_READONLY_MODE=true
MERQRY_MYSQL_HOST=
MERQRY_MYSQL_PORT=3307
MERQRY_MYSQL_DATABASE=mq_bio_organicos_analisis
MERQRY_MYSQL_USER=
MERQRY_MYSQL_PASSWORD=
